# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LLM Tier Model Configuration (used by src/llm/client.py)
FAST_MODEL="gemini-2.5-flash"
STRONG_MODEL="gemini-2.5-pro"

# PostgreSQL 16 + pgvector (docker-compose)
POSTGRES_DB="alderwood_rag"
POSTGRES_USER="alderwood_admin"
POSTGRES_PASSWORD="alderwood_dev_password"
POSTGRES_RO_USER="alderwood_readonly"
POSTGRES_RO_PASSWORD="alderwood_ro_password"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql+psycopg://alderwood_admin:alderwood_dev_password@localhost:5432/alderwood_rag"
READONLY_DATABASE_URL="postgresql+psycopg://alderwood_readonly:alderwood_ro_password@localhost:5432/alderwood_rag"
